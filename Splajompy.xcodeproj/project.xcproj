        }, {
          "package": "opentelemetry-swift",
          "product-name": "URLSessionInstrumentation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "opentelemetry-swift-core",
          "product-name": "OpenTelemetryApi",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "opentelemetry-swift-core",
          "product-name": "OpenTelemetrySdk",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "posthog-ios",
          "product-name": "PostHog",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES[sdk=*]": "snail-rainbow_icon snail-basic_icon snail_icon rainbow_icon pumpkin_icon original_icon exploding_icon",
