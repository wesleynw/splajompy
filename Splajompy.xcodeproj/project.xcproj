{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/kean/Nuke",
      "version": {
        "up-to-next-major-version": "13.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/open-telemetry/opentelemetry-swift-core.git",
      "version": {
        "up-to-next-major-version": "2.5.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/open-telemetry/opentelemetry-swift",
      "version": {
        "up-to-next-major-version": "2.3.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/PostHog/posthog-ios.git",
      "version": {
        "up-to-next-major-version": "3.89.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Assets",
      "target-membership": [
        "Splajompy",
      ],
      "membership-exceptions": [
        {
          "target": "Splajompy",
          "platforms": {
            "Launch Screen.storyboard": [ "ios" ],
          },
        },
      ],
    }, {
      "kind": "folder",
      "path": "Splajompy",
      "target-membership": [
        "Splajompy",
      ],
      "membership-exceptions": [
        {
          "target": "Splajompy",
          "exclusions": [
            "Configuration/Debug.xcconfig",
            "Configuration/Release.xcconfig",
            "Info.plist",
            "Splajompy.xctestplan",
            "Tests/GreatestRemainderQuotaTests.swift",
            "Tests/SessionHistoryServiceTests.swift",
          ],
          "platforms": {
            "Delegates/NSApplicationDelegate.swift": [ "macos" ],
            "Delegates/UIApplicationDelegate.swift": [ "ios" ],
            "Extensions/ImageResize.swift": [ "ios" ],
            "Extensions/PhotoLibrary.swift": [ "ios" ],
            "Onboarding/ImageOnboardingView.swift": [ "ios" ],
            "Onboarding/OnboardingSheetViewModifier.swift": [ "ios" ],
            "Onboarding/PartyInvite.swift": [ "ios" ],
            "Onboarding/PushNotificationsOnboardingView.swift": [ "ios" ],
            "Posts/Components/ImageCarousel.swift": [ "ios" ],
            "Posts/Components/ImagePager_ios.swift": [ "ios" ],
            "Posts/Components/ImagePager_macos.swift": [ "macos" ],
            "Posts/Components/ZoomableAsyncImage.swift": [ "ios" ],
            "Settings/AppIconPicker.swift": [ "ios" ],
            "Settings/SignedOutSettingsView.swift": [ "macos" ],
            "Utilities/AttributedTextEditor.swift": [ "ios" ],
            "Utilities/AttributedTextEditorMac.swift": [ "macos" ],
          },
        }, {
          "target": "SplajompyTests",
          "inclusions": [
            "Tests/GreatestRemainderQuotaTests.swift",
            "Tests/SessionHistoryServiceTests.swift",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Splajompy.app", "id": "184A63CB2D88CBA100860D6B", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SplajompyTests.xctest", "id": "184A63DB2D88CBA200860D6B", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/SplajompyUITests.xctest", "id": "184A63E52D88CBA200860D6B", "type": "wrapper.cfbundle", "index": false },
      ],
    },
    { "kind": "group", "name": "Frameworks" },
  ],
  "targets": [
    {
      "name": "Splajompy",
      "id": "184A63CA2D88CBA000860D6B",
      "product": "Products/Splajompy.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Splajompy", "relative-path": "Configuration/Debug.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Splajompy", "relative-path": "Configuration/Release.xcconfig" } },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Nuke",
